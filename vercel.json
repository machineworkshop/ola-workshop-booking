{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    },
    {
      "src": "backend/server.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/server.py" },
    { "handle": "filesystem" },
    { "src": "/static/(.*)", "dest": "frontend/build/static/$1" },
    { "src": "/(.*\\.(js|css|json|ico|png|jpg|jpeg|svg|webp|gif|txt|map|woff|woff2|ttf|eot))$", "dest": "frontend/build/$1" },
    { "src": "/(.*)", "dest": "frontend/build/index.html" }
  ]
}
